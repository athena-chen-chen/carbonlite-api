# Local development database.
# Copy this file to .env when you want to run CarbonLite against Docker Postgres.
DATABASE_URL="postgresql://carbonlite:carbonlite@localhost:5432/carbonlite_dev?schema=public"

# Required in every environment; replace with a private signing secret.
JWT_SECRET=<required-secret>
OPENAI_API_KEY=
PORT=3333
NODE_ENV=development
PUBLIC_REGISTRATION_ENABLED=false
DEMO_RESET_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Optional: backend error reporting
SENTRY_DSN=
RELEASE_VERSION=
REAL_DATA_EVIDENCE_HMAC_ACTIVE_VERSION=local-v1
REAL_DATA_EVIDENCE_HMAC_KEYRING=[{"version":"local-v1","key":"base64:<secure-random-base64>"}]
REQUIRE_EXPLICIT_INGESTION_DATA_MODE=false
