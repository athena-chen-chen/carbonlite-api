# Runtime database. Use Neon in shared environments, or the local Postgres
# URL from .env.local.example for local-only development.
DATABASE_URL=
# Required in every environment; replace with a private signing secret.
JWT_SECRET=<required-secret>
OPENAI_API_KEY=
PORT=3333
NODE_ENV=development
# Security controls. Public registration and demo reset default to disabled.
PUBLIC_REGISTRATION_ENABLED=false
DEMO_RESET_ENABLED=false
# Required in production. Local development defaults to http://localhost:5173.
CORS_ALLOWED_ORIGINS=
# Required in production and must equal the exact reverse-proxy hop count.
# Local development defaults to zero proxy hops.
TRUST_PROXY_HOPS=
# Optional per-IP request limits. Defaults are conservative when omitted.
# LOGIN_RATE_LIMIT=10
# REGISTRATION_RATE_LIMIT=3
# PASSWORD_SETUP_RATE_LIMIT=5
# DOCUMENT_UPLOAD_RATE_LIMIT=20
# AI_EXTRACTION_RATE_LIMIT=10
# Optional: backend error reporting
SENTRY_DSN=
RELEASE_VERSION=
