# Runtime database. Use Neon in shared environments, or the local Postgres
# URL from .env.local.example for local-only development.
DATABASE_URL=
# Required in every environment; replace with a private signing secret.
JWT_SECRET=<required-secret>
OPENAI_API_KEY=
PORT=3333
APP_ENV=production
NODE_ENV=production
# Public frontend origin used to create invitation links.
FRONTEND_URL=https://www.carbonliteapp.ca
# Security controls. Public registration and demo reset default to disabled.
PUBLIC_REGISTRATION_ENABLED=false
DEMO_RESET_ENABLED=false
# Required in production. Local development defaults to http://localhost:5173.
CORS_ALLOWED_ORIGINS=
# Required in production and must equal the exact reverse-proxy hop count.
# Local development defaults to zero proxy hops.
TRUST_PROXY_HOPS=
# Required in production. The path must be backed up durable storage.
DOCUMENT_STORAGE_PATH=
DOCUMENT_STORAGE_DURABLE=true
# One-run deployment interlock. Keep false except while intentionally loading
# the canonical production factor manifest, then immediately return it to false.
ALLOW_PRODUCTION_FACTOR_LOAD=false
# Optional per-IP request limits. Defaults are conservative when omitted.
# LOGIN_RATE_LIMIT=10
# REGISTRATION_RATE_LIMIT=3
# PASSWORD_SETUP_RATE_LIMIT=5
# DOCUMENT_UPLOAD_RATE_LIMIT=20
# AI_EXTRACTION_RATE_LIMIT=10
# Optional: backend error reporting
SENTRY_DSN=
# Set to the deployed backend commit SHA or RC identifier for traceability.
RELEASE_VERSION=
# Optional secret for explicitly authorized operator scripts. Platform authority
# itself is stored on the User platform role; organization ADMIN is not enough.
ADMIN_SCRIPT_TOKEN=
# Required before recording or withdrawing real-data approval. Use an independent
# 32+ character secret for HMAC-only compliance evidence identifiers.
REAL_DATA_EVIDENCE_HMAC_KEY=<required-secret-before-real-data-approval>
# Compatibility rollout: false permits missing mode only for synthetic-only
# organizations and audits the fallback. Set true after supported clients send
# X-CarbonLite-Data-Mode on every ingestion request.
REQUIRE_EXPLICIT_INGESTION_DATA_MODE=false
